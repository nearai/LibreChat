# Variables for the `librechat` service on Railway (Variables → Raw editor).
# Generate secrets: openssl rand -hex 32  (CREDS_IV: openssl rand -hex 16)
# Keep CREDS_* and JWT_* stable: changing them logs everyone out and breaks stored encrypted values.

HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=https://${{RAILWAY_PUBLIC_DOMAIN}}
DOMAIN_SERVER=https://${{RAILWAY_PUBLIC_DOMAIN}}
TRUST_PROXY=1
APP_TITLE=NEAR AI Chat

# The NEAR AI config shipped in this fork (nearai/librechat.yaml).
CONFIG_PATH=/app/nearai/librechat.yaml

MONGO_URI=${{MongoDB.MONGO_URL}}

NEAR_API_KEY=<dedicated NEAR AI Cloud key>
ENDPOINTS=custom
# Verification Center the shields link to. Leave unset until it is live;
# the shields still verify everything, only the "View details" link is hidden.
# NEAR_AI_VERIFY_URL=https://cloud.near.ai/verify

CREDS_KEY=<64 hex>
CREDS_IV=<32 hex>
JWT_SECRET=<64 hex>
JWT_REFRESH_SECRET=<64 hex>

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false

# Google sign-in, restricted to near.ai by registration.allowedDomains in nearai/librechat.yaml.
# OAuth client: Google Cloud project in the near.ai Workspace, consent screen "Internal",
# redirect URI https://<public domain>/oauth/google/callback
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_CALLBACK_URL=/oauth/google/callback
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

SEARCH=false
# One replica, no Redis: lets the scheduler start instead of logging an error.
SCHEDULES_SINGLE_PROCESS=true
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1
BAN_VIOLATIONS=true
